# ============================================
# BabyShower CMS — Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores

# Django Core
SECRET_KEY=django-insecure-CAMBIA-ESTO-EN-PRODUCCION
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Dejar vacío para usar SQLite local (desarrollo)
# En producción (Railway), se inyecta automáticamente con PostgreSQL
DATABASE_URL=

# Supabase Storage (para archivos media)
# Dejar vacío para usar filesystem local (desarrollo)
# En producción, configurar con tus credenciales de Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=media
